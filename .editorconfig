root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.m]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[library/**]
# Vendored third-party code: leave as upstream wrote it
indent_style = unset
indent_size = unset
insert_final_newline = unset
